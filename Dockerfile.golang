# Experimental Go workspace; separate from the native release image.
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/alist-go ./cmd/alist-go

FROM alpine:3.21
RUN addgroup -g 10001 kova && adduser -D -H -u 10001 -G kova kova \
    && mkdir -p /data && chown 10001:10001 /data
COPY --from=build /out/alist-go /usr/local/bin/alist-go
USER 10001:10001
EXPOSE 5244
ENTRYPOINT ["/usr/local/bin/alist-go"]
# KOVA_GO_TOKEN must be provided at runtime; writes remain disabled by default.
CMD ["server", "--experimental", "--addr", "0.0.0.0", "--root", "/data"]
