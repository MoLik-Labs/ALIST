{
  "name": "kova-native-workspace",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "webui:check": "node scripts/build_webui.mjs --check",
    "test:webui": "node scripts/build_webui.mjs --check && node tests/webui_smoke.mjs",
    "test:worker": "node tests/cloudflare_worker_test.mjs",
    "test:docs": "node tests/docs_smoke.mjs",
    "test:go-ui": "node tests/go_webui_smoke.mjs",
    "test:skills": "node tests/skills_integrity.mjs",
    "test:pages": "node tests/cloudflare_pages_test.mjs",
    "docs:dev": "vitepress dev docs/guide --host 127.0.0.1",
    "docs:build": "vitepress build docs/guide",
    "docs:preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory docs/guide/.vitepress/dist",
    "test:cf-native": "node tests/cloudflare_native_test.mjs",
    "test:cf-ui": "node tests/cloudflare_native_ui_test.mjs && node tests/cloudflare_ui_smoke.mjs",
    "test:docs-build": "node tests/docs_bilingual_smoke.mjs",
    "test:cf-google-drive": "node tests/cloudflare_google_drive_test.mjs",
    "test:cf-dropbox": "node tests/cloudflare_dropbox_test.mjs && node tests/cloudflare_connected_dropbox_test.mjs && node tests/cloudflare_dropbox_upload_test.mjs",
    "test:cf-access": "node tests/cloudflare_access_test.mjs",
    "test:cf-sessions": "node tests/cloudflare_sessions_test.mjs && node tests/cloudflare_browser_session_test.mjs",
    "test:cf-users": "node tests/cloudflare_user_management_test.mjs",
    "test:cf-roles": "node tests/cloudflare_role_management_test.mjs",
    "test:cf-vault": "node tests/cloudflare_credential_vault_test.mjs",
    "test:cf-connected-drive": "node tests/cloudflare_connected_drive_test.mjs",
    "test:cf-google-oauth": "node tests/cloudflare_google_oauth_test.mjs",
    "test:cf-identity": "node tests/cloudflare_google_identity_test.mjs",
    "test:cf-login": "node tests/cloudflare_google_login_test.mjs"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "vitepress": "1.6.4"
  }
}
